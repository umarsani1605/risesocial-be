          fc.integer({ min: 1, max: 5 }),
          fc.integer({ min: 1, max: 10 }),
          fc.integer({ min: 1, max: 50 }),
          fc.constantFrom('createdAt', 'name', 'rating', 'country'),
          fc.constantFrom('asc', 'desc'),
          async (country, minRating, page, limit, sortBy, sortOrder) => {
            vi.clearAllMocks();
            const mockTestimonials = [];
            const mockTotal = 100;

            mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);
            mockPrismaClient.testimonial.count.mockResolvedValue(mockTotal);

            await testimonialsRepository.findMany({ country, minRating }, page, limit, sortBy, sortOrder);

            const call = mockPrismaClient.testimonial.findMany.mock.calls[0][0];
            expect(call.where.country).toEqual({ contains: country, mode: 'insensitive' });
            expect(call.where.rating).toEqual({ gte: minRating });
            expect(call.skip).toBe((page - 1) * limit);
            expect(call.take).toBe(limit);
            expect(call.orderBy).toBeDefined();
          },
        ),
      );
    });
  });

  describe('Admin Sorting Properties', () => {
    it('property: findManyForAdmin supports status sorting', async () => {
      await fc.assert(
        fc.asyncProperty(fc.constantFrom('asc', 'desc'), async (sortOrder) => {
          const mockTestimonials = [];

          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          await testimonialsRepository.findManyForAdmin({}, undefined, undefined, 'status', sortOrder);

          expect(mockPrismaClient.testimonial.findMany).toHaveBeenCalledWith(
            expect.objectContaining({
              orderBy: { status: sortOrder },
            }),
          );
        }),
      );
    });

    it('property: findManyForAdmin supports all sortBy options from findMany', async () => {
      await fc.assert(
        fc.asyncProperty(
          fc.constantFrom('createdAt', 'name', 'rating', 'country', 'featured'),
          fc.constantFrom('asc', 'desc'),
          async (sortBy, sortOrder) => {
            vi.clearAllMocks();
            const mockTestimonials = [];

            mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

            await testimonialsRepository.findManyForAdmin({}, undefined, undefined, sortBy, sortOrder);

            const call = mockPrismaClient.testimonial.findMany.mock.calls[0][0];
            expect(call.orderBy).toBeDefined();
            expect(Object.values(call.orderBy)[0]).toBe(sortOrder);
          },
        ),
      );
    });

    it('property: findManyForAdmin has same default sorting as findMany', async () => {
      await fc.assert(
        fc.asyncProperty(fc.constant(null), async () => {
          const mockTestimonials = [];

          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          await testimonialsRepository.findManyForAdmin({}, undefined, undefined);

          expect(mockPrismaClient.testimonial.findMany).toHaveBeenCalledWith(
            expect.objectContaining({
              orderBy: { created_at: 'desc' },
            }),
          );
        }),
      );
    });

    it('property: findManyForAdmin invalid sortBy defaults to created_at desc', async () => {
      await fc.assert(
        fc.asyncProperty(
          fc.string({ minLength: 1, maxLength: 20 }).filter((s) => !['createdAt', 'name', 'rating', 'country', 'featured', 'status'].includes(s)),
          fc.constantFrom('asc', 'desc'),
          async (invalidSortBy, sortOrder) => {
            vi.clearAllMocks();
            const mockTestimonials = [];

            mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

            await testimonialsRepository.findManyForAdmin({}, undefined, undefined, invalidSortBy, sortOrder);

            expect(mockPrismaClient.testimonial.findMany).toHaveBeenCalledWith(
              expect.objectContaining({
                orderBy: { created_at: 'desc' },
              }),
            );
          },
        ),
      );
    });
  });

  describe('Sorting Consistency Properties', () => {
    it('property: same sorting parameters produce same orderBy clause', async () => {
      await fc.assert(
        fc.asyncProperty(fc.constantFrom('createdAt', 'name', 'rating', 'country'), fc.constantFrom('asc', 'desc'), async (sortBy, sortOrder) => {
          vi.clearAllMocks();
          const mockTestimonials = [];

          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          await testimonialsRepository.findMany({}, undefined, undefined, sortBy, sortOrder);
          const call1 = mockPrismaClient.testimonial.findMany.mock.calls[0][0];

          vi.clearAllMocks();
          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          await testimonialsRepository.findMany({}, undefined, undefined, sortBy, sortOrder);
          const call2 = mockPrismaClient.testimonial.findMany.mock.calls[0][0];

          expect(call1.orderBy).toEqual(call2.orderBy);
        }),
      );
    });

    it('property: sorting is deterministic across multiple calls', async () => {
      await fc.assert(
        fc.asyncProperty(fc.constantFrom('createdAt', 'name', 'rating', 'country'), fc.constantFrom('asc', 'desc'), async (sortBy, sortOrder) => {
          vi.clearAllMocks();
          const mockTestimonials = [];

          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          // First call
          await testimonialsRepository.findMany({}, undefined, undefined, sortBy, sortOrder);
          const orderBy1 = mockPrismaClient.testimonial.findMany.mock.calls[0][0].orderBy;

          vi.clearAllMocks();
          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          // Second call
          await testimonialsRepository.findMany({}, undefined, undefined, sortBy, sortOrder);
          const orderBy2 = mockPrismaClient.testimonial.findMany.mock.calls[0][0].orderBy;

          expect(orderBy1).toEqual(orderBy2);
        }),
      );
    });
  });

  describe('Sorting Edge Cases', () => {
    it('property: sorting with empty filters still applies orderBy', async () => {
      await fc.assert(
        fc.asyncProperty(fc.constantFrom('createdAt', 'name', 'rating', 'country'), fc.constantFrom('asc', 'desc'), async (sortBy, sortOrder) => {
          vi.clearAllMocks();
          const mockTestimonials = [];

          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          await testimonialsRepository.findMany({}, undefined, undefined, sortBy, sortOrder);

          const call = mockPrismaClient.testimonial.findMany.mock.calls[0][0];
          expect(call.orderBy).toBeDefined();
          expect(Object.keys(call.orderBy).length).toBe(1);
        }),
      );
    });

    it('property: sorting parameters are independent of filter parameters', async () => {
      await fc.assert(
        fc.asyncProperty(
          fc.string({ minLength: 1, maxLength: 20 }),
          fc.constantFrom('createdAt', 'name', 'rating', 'country'),
          fc.constantFrom('asc', 'desc'),
          async (country, sortBy, sortOrder) => {
            vi.clearAllMocks();
            const mockTestimonials = [];

            mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

            await testimonialsRepository.findMany({ country }, undefined, undefined, sortBy, sortOrder);

            const call = mockPrismaClient.testimonial.findMany.mock.calls[0][0];
            // Verify both where and orderBy are present and independent
            expect(call.where).toBeDefined();
            expect(call.orderBy).toBeDefined();
            expect(call.where.country).toEqual({ contains: country, mode: 'insensitive' });
          },
        ),
      );
    });

    it('property: sorting by rating field does not conflict with minRating filter', async () => {
      await fc.assert(
        fc.asyncProperty(fc.integer({ min: 1, max: 5 }), fc.constantFrom('asc', 'desc'), async (minRating, sortOrder) => {
          vi.clearAllMocks();
          const mockTestimonials = [];

          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          await testimonialsRepository.findMany({ minRating }, undefined, undefined, 'rating', sortOrder);

          const call = mockPrismaClient.testimonial.findMany.mock.calls[0][0];
          expect(call.where.rating).toEqual({ gte: minRating });
          expect(call.orderBy.rating).toBe(sortOrder);
        }),
      );
    });

    it('property: sorting by country field does not conflict with country filter', async () => {
      await fc.assert(
        fc.asyncProperty(fc.string({ minLength: 1, maxLength: 20 }), fc.constantFrom('asc', 'desc'), async (country, sortOrder) => {
          vi.clearAllMocks();
          const mockTestimonials = [];

          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          await testimonialsRepository.findMany({ country }, undefined, undefined, 'country', sortOrder);

          const call = mockPrismaClient.testimonial.findMany.mock.calls[0][0];
          expect(call.where.country).toEqual({ contains: country, mode: 'insensitive' });
          expect(call.orderBy.country).toBe(sortOrder);
        }),
      );
    });

    it('property: sorting by featured field does not conflict with featured filter', async () => {
      await fc.assert(
        fc.asyncProperty(fc.boolean(), fc.constantFrom('asc', 'desc'), async (featured, sortOrder) => {
          vi.clearAllMocks();
          const mockTestimonials = [];

          mockPrismaClient.testimonial.findMany.mockResolvedValue(mockTestimonials);

          await testimonialsRepository.findMany({ featured }, undefined, undefined, 'featured', sortOrder);

          const call = mockPrismaClient.testimonial.findMany.mock.calls[0][0];
          expect(call.where.featured).toBe(featured);
          expect(call.orderBy.featured).toBe(sortOrder);
        }),
      );
    });
  });
});
