  describe('validateTestimonialData()', () => {
    // Task 12.14 - Test validateTestimonialData() for all rules
    describe('name validation', () => {
      it('should require name on create', () => {
        const data = {
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Name is required and must be a string');
      });

      it('should validate name is a string', () => {
        const data = {
          name: 123,
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Name is required and must be a string');
      });

      it('should validate name minimum length (2 chars)', () => {
        const data = {
          name: 'A',
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Name must be at least 2 characters long');
      });

      it('should validate name maximum length (255 chars)', () => {
        const data = {
          name: 'A'.repeat(256),
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Name must be less than 255 characters');
      });

      it('should allow missing name on update', () => {
        const data = {
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
        };

        const result = adminTestimonialsService.validateTestimonialData(data, true);

        expect(result.isValid).toBe(true);
        expect(result.errors).toHaveLength(0);
      });
    });

    describe('country validation', () => {
      it('should require country on create', () => {
        const data = {
          name: 'John Doe',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Country is required and must be a string');
      });

      it('should validate country is a string', () => {
        const data = {
          name: 'John Doe',
          country: 123,
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
