/**
 * TestimonialsService Unit Tests
 * Tests business logic with mocked repository
 */

import { describe, it, expect, vi, beforeEach } from 'vitest';
import { getMockTestimonial, getMockPaginatedResult, getMockResultWithoutPagination } from '../../helpers/testimonialsFixtures.js';

// Mock repository
const mockTestimonialsRepository = {
  findMany: vi.fn(),
  findManyForAdmin: vi.fn(),
  findById: vi.fn(),
  create: vi.fn(),
  update: vi.fn(),
  delete: vi.fn(),
};

// Mock user repository
vi.mock('../../../src/repositories/user/testimonialsRepository.js', () => ({
  userTestimonialsRepository: mockTestimonialsRepository,
}));

// Mock admin repository
const mockAdminTestimonialsRepository = {
  findMany: vi.fn(),
  findById: vi.fn(),
  create: vi.fn(),
  update: vi.fn(),
  delete: vi.fn(),
  getStatistics: vi.fn(),
};

vi.mock('../../../src/repositories/admin/testimonialsRepository.js', () => ({
  adminTestimonialsRepository: mockAdminTestimonialsRepository,
}));

// Mock logger
vi.mock('../../../src/utils/loggerContext.js', () => ({
  getLogger: () => ({
    info: vi.fn(),
    debug: vi.fn(),
    error: vi.fn(),
  }),
}));

// Import after mocking
const { userTestimonialsService } = await import('../../../src/services/user/testimonialsService.js');
const { adminTestimonialsService } = await import('../../../src/services/admin/testimonialsService.js');

describe('TestimonialsService', () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  describe('getTestimonials()', () => {
    // Task 12.2 - Test getTestimonials() with filters
    it('should return testimonials with country filter', async () => {
      const mockTestimonials = [getMockTestimonial({ country: 'Indonesia' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({ country: 'Indonesia' });

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith(
        { country: 'Indonesia', status: 'ACTIVE' },
        undefined,
        undefined,
        'createdAt',
        'desc',
      );
      expect(result.testimonials).toEqual(mockTestimonials);
      expect(result.pagination).toBeUndefined();
    });

    it('should return testimonials with minRating filter', async () => {
      const mockTestimonials = [getMockTestimonial({ rating: 5 })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({ minRating: 4 });

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith({ minRating: 4, status: 'ACTIVE' }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should return testimonials with featured filter', async () => {
      const mockTestimonials = [getMockTestimonial({ featured: true })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({ featured: true });

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith(
        { featured: true, status: 'ACTIVE' },
        undefined,
        undefined,
        'createdAt',
        'desc',
      );
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should return testimonials with search filter', async () => {
      const mockTestimonials = [getMockTestimonial({ name: 'John Doe' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({ search: 'John' });

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith(
        { search: 'John', status: 'ACTIVE' },
        undefined,
        undefined,
        'createdAt',
        'desc',
      );
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should return testimonials with multiple filters', async () => {
      const mockTestimonials = [getMockTestimonial({ country: 'Indonesia', rating: 5, featured: true })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({
        country: 'Indonesia',
        minRating: 4,
        featured: true,
      });

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith(
        { country: 'Indonesia', minRating: 4, featured: true, status: 'ACTIVE' },
        undefined,
        undefined,
        'createdAt',
        'desc',
      );
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should enforce ACTIVE status filter for public endpoint', async () => {
      const mockTestimonials = [getMockTestimonial({ status: 'ACTIVE' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      await userTestimonialsService.getTestimonials({});

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'ACTIVE' }, undefined, undefined, 'createdAt', 'desc');
    });

    it('should override any status filter with ACTIVE for public endpoint', async () => {
      const mockTestimonials = [getMockTestimonial({ status: 'ACTIVE' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      await userTestimonialsService.getTestimonials({ status: 'INACTIVE' });

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'ACTIVE' }, undefined, undefined, 'createdAt', 'desc');
    });

    it('should pass custom sortBy and sortOrder to repository', async () => {
      const mockTestimonials = [getMockTestimonial()];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      await userTestimonialsService.getTestimonials({}, undefined, undefined, 'name', 'asc');

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'ACTIVE' }, undefined, undefined, 'name', 'asc');
    });

    it('should handle repository errors gracefully', async () => {
      mockTestimonialsRepository.findMany.mockRejectedValue(new Error('Database error'));

      await expect(userTestimonialsService.getTestimonials({})).rejects.toThrow('Failed to get testimonials: Database error');
    });

    // Task 12.3 - Test getTestimonials() with pagination
    it('should return paginated testimonials when page/limit provided', async () => {
      const mockTestimonials = [getMockTestimonial(), getMockTestimonial({ id: 2, name: 'Jane Doe' })];
      const mockPagination = {
        page: 1,
        limit: 10,
        total: 25,
        totalPages: 3,
        hasNext: true,
        hasPrev: false,
      };
      const mockResult = getMockPaginatedResult(mockTestimonials, mockPagination);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({}, 1, 10);

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'ACTIVE' }, 1, 10, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
      expect(result.pagination).toEqual(mockPagination);
    });

    it('should pass page and limit correctly to repository', async () => {
      const mockTestimonials = [getMockTestimonial()];
      const mockPagination = {
        page: 2,
        limit: 5,
        total: 15,
        totalPages: 3,
        hasNext: true,
        hasPrev: true,
      };
      const mockResult = getMockPaginatedResult(mockTestimonials, mockPagination);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({}, 2, 5);

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'ACTIVE' }, 2, 5, 'createdAt', 'desc');
      expect(result.pagination.page).toBe(2);
      expect(result.pagination.limit).toBe(5);
    });

    it('should return pagination metadata with correct values', async () => {
      const mockTestimonials = [getMockTestimonial()];
      const mockPagination = {
        page: 3,
        limit: 10,
        total: 25,
        totalPages: 3,
        hasNext: false,
        hasPrev: true,
      };
      const mockResult = getMockPaginatedResult(mockTestimonials, mockPagination);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({}, 3, 10);

      expect(result.pagination).toBeDefined();
      expect(result.pagination.page).toBe(3);
      expect(result.pagination.limit).toBe(10);
      expect(result.pagination.total).toBe(25);
      expect(result.pagination.totalPages).toBe(3);
      expect(result.pagination.hasNext).toBe(false);
      expect(result.pagination.hasPrev).toBe(true);
    });

    // Task 12.4 - Test getTestimonials() without pagination (fetch all)
    it('should return all testimonials when no page/limit provided', async () => {
      const mockTestimonials = [
        getMockTestimonial({ id: 1, name: 'John Doe' }),
        getMockTestimonial({ id: 2, name: 'Jane Smith' }),
        getMockTestimonial({ id: 3, name: 'Bob Johnson' }),
      ];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({});

      expect(mockTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'ACTIVE' }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
      expect(result.pagination).toBeUndefined();
    });

    it('should return all testimonials without pagination metadata', async () => {
      const mockTestimonials = [getMockTestimonial()];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await userTestimonialsService.getTestimonials({}, undefined, undefined);

      expect(result).toHaveProperty('testimonials');
      expect(result).not.toHaveProperty('pagination');
      expect(result.testimonials).toEqual(mockTestimonials);
    });
  });

  describe('getTestimonialsForAdmin()', () => {
    // Task 12.5 - Test getTestimonialsForAdmin() with filters
    it('should return testimonials with country filter', async () => {
      const mockTestimonials = [getMockTestimonial({ country: 'Indonesia' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({ country: 'Indonesia' });

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({ country: 'Indonesia' }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
      expect(result.pagination).toBeUndefined();
    });

    it('should return testimonials with minRating filter', async () => {
      const mockTestimonials = [getMockTestimonial({ rating: 5 })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({ minRating: 4 });

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({ minRating: 4 }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should return testimonials with featured filter', async () => {
      const mockTestimonials = [getMockTestimonial({ featured: true })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({ featured: true });

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({ featured: true }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should return testimonials with search filter', async () => {
      const mockTestimonials = [getMockTestimonial({ name: 'John Doe' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({ search: 'John' });

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({ search: 'John' }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should allow filtering by any status (ACTIVE)', async () => {
      const mockTestimonials = [getMockTestimonial({ status: 'ACTIVE' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({ status: 'ACTIVE' });

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'ACTIVE' }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should allow filtering by any status (INACTIVE)', async () => {
      const mockTestimonials = [getMockTestimonial({ status: 'INACTIVE' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({ status: 'INACTIVE' });

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'INACTIVE' }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should allow filtering by any status (PENDING)', async () => {
      const mockTestimonials = [getMockTestimonial({ status: 'PENDING' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({ status: 'PENDING' });

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({ status: 'PENDING' }, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should return testimonials with multiple filters', async () => {
      const mockTestimonials = [getMockTestimonial({ country: 'Indonesia', rating: 5, featured: true, status: 'ACTIVE' })];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({
        country: 'Indonesia',
        minRating: 4,
        featured: true,
        status: 'ACTIVE',
      });

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith(
        { country: 'Indonesia', minRating: 4, featured: true, status: 'ACTIVE' },
        undefined,
        undefined,
        'createdAt',
        'desc',
      );
      expect(result.testimonials).toEqual(mockTestimonials);
    });

    it('should NOT enforce ACTIVE status filter for admin endpoint', async () => {
      const mockTestimonials = [
        getMockTestimonial({ status: 'ACTIVE' }),
        getMockTestimonial({ id: 2, status: 'INACTIVE' }),
        getMockTestimonial({ id: 3, status: 'PENDING' }),
      ];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      await adminTestimonialsService.getTestimonials({});

      // Should pass empty filters, NOT enforce status: 'ACTIVE'
      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({}, undefined, undefined, 'createdAt', 'desc');
    });

    it('should pass custom sortBy and sortOrder to repository', async () => {
      const mockTestimonials = [getMockTestimonial()];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      await adminTestimonialsService.getTestimonials({}, undefined, undefined, 'name', 'asc');

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({}, undefined, undefined, 'name', 'asc');
    });

    it('should handle repository errors gracefully', async () => {
      mockAdminTestimonialsRepository.findMany.mockRejectedValue(new Error('Database error'));

      await expect(adminTestimonialsService.getTestimonials({})).rejects.toThrow('Failed to get testimonials for admin: Database error');
    });

    // Task 12.6 - Test getTestimonialsForAdmin() with and without pagination
    it('should return paginated testimonials when page/limit provided', async () => {
      const mockTestimonials = [getMockTestimonial(), getMockTestimonial({ id: 2, name: 'Jane Doe' })];
      const mockPagination = {
        page: 1,
        limit: 10,
        total: 25,
        totalPages: 3,
        hasNext: true,
        hasPrev: false,
      };
      const mockResult = getMockPaginatedResult(mockTestimonials, mockPagination);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({}, 1, 10);

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({}, 1, 10, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
      expect(result.pagination).toEqual(mockPagination);
    });

    it('should pass page and limit correctly to repository', async () => {
      const mockTestimonials = [getMockTestimonial()];
      const mockPagination = {
        page: 2,
        limit: 5,
        total: 15,
        totalPages: 3,
        hasNext: true,
        hasPrev: true,
      };
      const mockResult = getMockPaginatedResult(mockTestimonials, mockPagination);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({}, 2, 5);

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({}, 2, 5, 'createdAt', 'desc');
      expect(result.pagination.page).toBe(2);
      expect(result.pagination.limit).toBe(5);
    });

    it('should return pagination metadata with correct values', async () => {
      const mockTestimonials = [getMockTestimonial()];
      const mockPagination = {
        page: 3,
        limit: 10,
        total: 25,
        totalPages: 3,
        hasNext: false,
        hasPrev: true,
      };
      const mockResult = getMockPaginatedResult(mockTestimonials, mockPagination);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({}, 3, 10);

      expect(result.pagination).toBeDefined();
      expect(result.pagination.page).toBe(3);
      expect(result.pagination.limit).toBe(10);
      expect(result.pagination.total).toBe(25);
      expect(result.pagination.totalPages).toBe(3);
      expect(result.pagination.hasNext).toBe(false);
      expect(result.pagination.hasPrev).toBe(true);
    });

    it('should return all testimonials when no page/limit provided', async () => {
      const mockTestimonials = [
        getMockTestimonial({ id: 1, name: 'John Doe', status: 'ACTIVE' }),
        getMockTestimonial({ id: 2, name: 'Jane Smith', status: 'INACTIVE' }),
        getMockTestimonial({ id: 3, name: 'Bob Johnson', status: 'PENDING' }),
      ];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({});

      expect(mockAdminTestimonialsRepository.findMany).toHaveBeenCalledWith({}, undefined, undefined, 'createdAt', 'desc');
      expect(result.testimonials).toEqual(mockTestimonials);
      expect(result.pagination).toBeUndefined();
    });

    it('should return all testimonials without pagination metadata', async () => {
      const mockTestimonials = [getMockTestimonial()];
      const mockResult = getMockResultWithoutPagination(mockTestimonials);
      mockAdminTestimonialsRepository.findMany.mockResolvedValue(mockResult);

      const result = await adminTestimonialsService.getTestimonials({}, undefined, undefined);

      expect(result).toHaveProperty('testimonials');
      expect(result).not.toHaveProperty('pagination');
      expect(result.testimonials).toEqual(mockTestimonials);
    });
  });

  describe('getTestimonialById()', () => {
    // Task 12.7 - Test getTestimonialById() success and error
    it('should return testimonial when found', async () => {
      const mockTestimonial = getMockTestimonial({ id: 1, name: 'John Doe' });
      mockTestimonialsRepository.findById.mockResolvedValue(mockTestimonial);

      const result = await userTestimonialsService.getTestimonialById(1);

      expect(mockTestimonialsRepository.findById).toHaveBeenCalledWith(1);
      expect(result).toEqual(mockTestimonial);
    });

    it('should return null when testimonial not found', async () => {
      mockTestimonialsRepository.findById.mockResolvedValue(null);

      const result = await userTestimonialsService.getTestimonialById(999);

      expect(mockTestimonialsRepository.findById).toHaveBeenCalledWith(999);
      expect(result).toBeNull();
    });

    it('should handle repository errors gracefully', async () => {
      mockTestimonialsRepository.findById.mockRejectedValue(new Error('Database connection failed'));

      await expect(userTestimonialsService.getTestimonialById(1)).rejects.toThrow('Failed to get testimonial by ID: Database connection failed');
    });
  });

  describe('createTestimonial()', () => {
    // Task 12.8 - Test createTestimonial() with valid data
    it('should create testimonial with valid data', async () => {
      const inputData = {
        name: 'John Doe',
        country: 'Indonesia',
        text: 'This is a great testimonial with sufficient length.',
        rating: 5,
        status: 'ACTIVE',
        featured: true,
        avatar_url: 'https://example.com/avatar.jpg',
      };

      const expectedData = {
        name: 'John Doe',
        country: 'Indonesia',
        text: 'This is a great testimonial with sufficient length.',
        rating: 5,
        status: 'ACTIVE',
        featured: true,
      };

      const mockCreated = getMockTestimonial({
        ...expectedData,
        id: 1,
        avatar_url: 'https://example.com/avatar.jpg',
      });

      mockAdminTestimonialsRepository.create.mockResolvedValue(mockCreated);

      const result = await adminTestimonialsService.createTestimonial(inputData);

      expect(mockAdminTestimonialsRepository.create).toHaveBeenCalledWith(expectedData);
      expect(result).toEqual(mockCreated);
    });

    it('should trim whitespace from text fields', async () => {
      const inputData = {
        name: '  John Doe  ',
        country: '  Indonesia  ',
        text: '  This is a great testimonial with sufficient length.  ',
        rating: 5,
      };

      const expectedData = {
        name: 'John Doe',
        country: 'Indonesia',
        text: 'This is a great testimonial with sufficient length.',
        rating: 5,
        status: 'ACTIVE',
        featured: false,
      };

      const mockCreated = getMockTestimonial(expectedData);
      mockAdminTestimonialsRepository.create.mockResolvedValue(mockCreated);

      await adminTestimonialsService.createTestimonial(inputData);

      expect(mockAdminTestimonialsRepository.create).toHaveBeenCalledWith(expectedData);
    });

    it('should set default values (status: ACTIVE, featured: false)', async () => {
      const inputData = {
        name: 'John Doe',
        country: 'Indonesia',
        text: 'This is a great testimonial with sufficient length.',
        rating: 5,
        // No status or featured provided
      };

      const expectedData = {
        name: 'John Doe',
        country: 'Indonesia',
        text: 'This is a great testimonial with sufficient length.',
        rating: 5,
        status: 'ACTIVE',
        featured: false,
      };

      const mockCreated = getMockTestimonial(expectedData);
      mockAdminTestimonialsRepository.create.mockResolvedValue(mockCreated);

      await adminTestimonialsService.createTestimonial(inputData);

      expect(mockAdminTestimonialsRepository.create).toHaveBeenCalledWith(expectedData);
    });

    it('should convert rating to integer', async () => {
      const inputData = {
        name: 'John Doe',
        country: 'Indonesia',
        text: 'This is a great testimonial with sufficient length.',
        rating: '5', // String rating
      };

      const expectedData = {
        name: 'John Doe',
        country: 'Indonesia',
        text: 'This is a great testimonial with sufficient length.',
        rating: 5, // Should be converted to integer
        status: 'ACTIVE',
        featured: false,
      };

      const mockCreated = getMockTestimonial(expectedData);
      mockAdminTestimonialsRepository.create.mockResolvedValue(mockCreated);

      await adminTestimonialsService.createTestimonial(inputData);

      expect(mockAdminTestimonialsRepository.create).toHaveBeenCalledWith(expectedData);
    });

    it('should create testimonial with all fields provided', async () => {
      const inputData = {
        name: 'Jane Smith',
        country: 'Singapore',
        text: 'Amazing program that changed my life and perspective.',
        rating: 4,
        status: 'PENDING',
        featured: true,
      };

      const expectedData = {
        name: 'Jane Smith',
        country: 'Singapore',
        text: 'Amazing program that changed my life and perspective.',
        rating: 4,
        status: 'PENDING',
        featured: true,
      };

      const mockCreated = getMockTestimonial({ ...expectedData, id: 2 });
      mockAdminTestimonialsRepository.create.mockResolvedValue(mockCreated);

      const result = await adminTestimonialsService.createTestimonial(inputData);

      expect(mockAdminTestimonialsRepository.create).toHaveBeenCalledWith(expectedData);
      expect(result).toEqual(mockCreated);
    });

    it('should trim whitespace and set defaults together', async () => {
      const inputData = {
        name: '  Alice Johnson  ',
        country: '  Malaysia  ',
        text: '  Excellent program with great content and support.  ',
        rating: '3',
      };

      const expectedData = {
        name: 'Alice Johnson',
        country: 'Malaysia',
        text: 'Excellent program with great content and support.',
        rating: 3,
        status: 'ACTIVE',
        featured: false,
      };

      const mockCreated = getMockTestimonial(expectedData);
