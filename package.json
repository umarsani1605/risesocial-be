{
  "name": "risesocial-be",
  "version": "1.0.0",
  "description": "Backend API for Rise Social Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "prisma init",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "seed": "node prisma/seeds/index.js",
    "seed:users": "node prisma/seeds/index.js --domain=users",
    "seed:academies": "node prisma/seeds/index.js --domain=academies",
    "seed:cohorts": "node prisma/seeds/index.js --domain=cohorts",
    "seed:jobs": "node prisma/seeds/index.js --domain=jobs",
    "seed:ryls": "node prisma/seeds/index.js --domain=ryls",
    "seed:payments": "node prisma/seeds/index.js --domain=payments",
    "seed:testimonials": "node prisma/seeds/index.js --domain=testimonials",
    "seed:clear": "node prisma/seeds/index.js --clear",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "api"
  ],
  "author": "Rise Social Team",
  "license": "MIT",
  "dependencies": {
    "@everapi/freecurrencyapi-js": "^1.0.1",
    "@fastify/caching": "^9.0.3",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.10.1",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "fs-extra": "^11.3.1",
    "midtrans-client": "^1.4.3",
    "pdfkit": "^0.17.2",
    "prisma": "^6.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@vitest/coverage-v8": "^4.0.16",
    "fast-check": "^4.5.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1",
    "vitest": "^4.0.16"
  },
  "prisma": {
    "seed": "node prisma/seeds/index.js"
  }
}
