generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User management domain - handles authentication, profiles, and settings
model User {
  id                  Int                  @id @default(autoincrement())
  username            String               @db.VarChar(50)
  first_name          String               @db.VarChar(100)
  last_name           String               @db.VarChar(100)
  avatar              String?              @db.VarChar(500)
  email               String               @unique @db.VarChar(255)
  phone               String?              @db.VarChar(20)
  password            String               @db.VarChar(255)
  email_verified_at   DateTime?
  phone_verified_at   DateTime?
  role                UserRole             @default(USER)
  gender              Gender?
  country             String?              @db.VarChar(100)
  province            String?              @db.VarChar(100)
  city                String?              @db.VarChar(100)
  last_education      String?              @db.VarChar(255)
  current_job         String?              @db.VarChar(255)
  current_company     String?              @db.VarChar(255)
  skills              String[]
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  job_applications    JobApplication[]
  transactions        Transaction[]        @relation("UserTransactions")
  saved_jobs          UserSavedJob[]
  user_settings       UserSetting[]
  academy_enrollments    AcademyEnrollment[]          @relation("UserAcademyEnrollments")
  cohort_placements      CohortPlacement[]            @relation("UserCohortPlacements")
  cohort_certificates    CohortCertificate[]          @relation("UserCohortCertificates")
  assignment_completions CohortAssignmentCompletion[] @relation("UserAssignmentCompletions")
  admin_permissions      UserAdminPermission[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([created_at(sort: Desc)])
  @@map("users")
}

/// User settings using key-value structure
model UserSetting {
  id         Int      @id @default(autoincrement())
  user_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  key        String?  @db.VarChar(100)
  value      Json?
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, key])
  @@index([user_id])
  @@index([key])
  @@map("user_settings")
}

/// Main academy entity with comprehensive metadata and validation
model Academy {
  id           Int                  @id @default(autoincrement())
  title        String               @db.VarChar(255)
  slug         String               @unique @db.VarChar(255)
  description  String?
  duration     String?              @db.VarChar(100)
  format       String?              @db.VarChar(100)
  category     String?              @db.VarChar(100)
  image_url    String?              @db.VarChar(500)
  certificate  Boolean              @default(false)
  portfolio    Boolean              @default(false)
  status       AcademyStatus        @default(ACTIVE)
  pixel_id     String?              @db.VarChar(100)
  created_at   DateTime             @default(now())
  updated_at   DateTime             @updatedAt
  faqs         AcademyFaq[]         @relation("AcademyFaqRelation")
  features     AcademyFeature[]     @relation("AcademyFeatureRelation")
  instructors  AcademyInstructor[]  @relation("AcademyInstructorRelation")
  pricing      AcademyPricing[]     @relation("AcademyPricingRelation")
  testimonials AcademyTestimonial[] @relation("AcademyTestimonialRelation")
  themes                  AcademyTheme[]            @relation("AcademyThemeRelation")
  topics                  AcademyTopic[]            @relation("AcademyTopicRelation")
  cohorts                 Cohort[]                  @relation("AcademyCohorts")
  cohort_modules          CohortModule[]            @relation("AcademyCohortModules")
  cohort_attachments      CohortModuleAttachment[]  @relation("AcademyCohortAttachments")
  academy_enrollments     AcademyEnrollment[]       @relation("AcademyEnrollments")
  cohort_placements       CohortPlacement[]         @relation("AcademyCohortPlacements")
  file_uploads            FileUpload[]              @relation("AcademyFiles")
  cohort_mentors          CohortMentor[]            @relation("AcademyCohortMentors")
  cohort_certificates     CohortCertificate[]       @relation("AcademyCohortCertificates")

  @@index([category, status])
  @@index([status])
  @@index([created_at(sort: Desc)])
  @@index([slug])
  @@map("academies")
}

/// academy pricing tiers with validation
model AcademyPricing {
  id             Int      @id @default(autoincrement())
  academy_id     Int
  name           String   @db.VarChar(100)
  original_price Int
  discount_price Int
  order          Int      @default(1)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  academy        Academy  @relation("AcademyPricingRelation", fields: [academy_id], references: [id], onDelete: Cascade)

  @@index([academy_id, order])
  @@map("academy_pricing")
}

/// academy features and benefits
model AcademyFeature {
  id          Int      @id @default(autoincrement())
  academy_id  Int
  title       String   @db.VarChar(255)
  description String?
  icon        String?  @db.VarChar(100)
  order       Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  academy     Academy  @relation("AcademyFeatureRelation", fields: [academy_id], references: [id], onDelete: Cascade)

  @@index([academy_id, order])
  @@map("academy_features")
}

/// Academy curriculum themes (Level 1 - formerly topics)
model AcademyTheme {
  id          Int            @id @default(autoincrement())
  academy_id  Int
  title       String         @db.VarChar(255)
  description String?
  order       Int            @default(1)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  topics      AcademyTopic[] @relation("ThemeTopicRelation")
  academy     Academy        @relation("AcademyThemeRelation", fields: [academy_id], references: [id], onDelete: Cascade)

  @@index([academy_id, order])
  @@map("academy_themes")
}

/// academy curriculum topics (Level 2 - formerly sessions)
model AcademyTopic {
  id          Int          @id @default(autoincrement())
  academy_id  Int
  theme_id    Int
  title       String       @db.VarChar(255)
  description String?
  order       Int          @default(1)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  academy     Academy      @relation("AcademyTopicRelation", fields: [academy_id], references: [id], onDelete: Cascade)
  theme       AcademyTheme @relation("ThemeTopicRelation", fields: [theme_id], references: [id], onDelete: Cascade)

  @@index([academy_id, order])
  @@index([theme_id, order])
  @@map("academy_topics")
}

/// academy instructors (denormalized - stores instructor data directly)
model AcademyInstructor {
  id          Int      @id @default(autoincrement())
  academy_id  Int
  name        String   @db.VarChar(255)
  job_title   String?  @db.VarChar(255)
  avatar_url  String?  @db.VarChar(500)
  description String?
  order       Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  academy     Academy  @relation("AcademyInstructorRelation", fields: [academy_id], references: [id], onDelete: Cascade)

  @@index([academy_id, order])
  @@index([name])
  @@map("academy_instructors")
}

/// Alumni testimonials and reviews
model AcademyTestimonial {
  id         Int      @id @default(autoincrement())
  academy_id Int
  name       String   @db.VarChar(255)
  avatar_url String?  @db.VarChar(500)
  comment    String
  order      Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  academy    Academy  @relation("AcademyTestimonialRelation", fields: [academy_id], references: [id], onDelete: Cascade)

  @@index([academy_id, order])
  @@map("academy_testimonials")
}

/// Frequently asked questions
model AcademyFaq {
  id         Int      @id @default(autoincrement())
  academy_id Int
  question   String
  answer     String
  order      Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  academy    Academy  @relation("AcademyFaqRelation", fields: [academy_id], references: [id], onDelete: Cascade)

  @@index([academy_id, order])
  @@map("academy_faqs")
}

/// Enhanced Companies table dengan full LinkedIn data
model Company {
  id                             Int      @id @default(autoincrement())
  name                           String   @db.VarChar(255)
  slug                           String   @unique @db.VarChar(255)
  logo_url                       String?  @db.VarChar(500)
  website_url                    String?  @db.VarChar(500)
  industry                       String?  @db.VarChar(255)
  headquarters                   String?  @db.VarChar(255)
  description                    String?
  linkedin_url                   String?  @db.VarChar(500)
  linkedin_slug                  String?  @db.VarChar(255)
  linkedin_employees             Int?
  linkedin_size                  String?  @db.VarChar(100)
  linkedin_slogan                String?  @db.VarChar(500)
  linkedin_followers             Int?
  linkedin_type                  String?  @db.VarChar(100)
  linkedin_founded_date          String?  @db.VarChar(4)
  linkedin_specialties           Json?
  linkedin_locations             Json?
  linkedin_is_recruitment_agency Boolean  @default(false)
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt
  jobs                           Job[]

  @@index([industry])
  @@index([linkedin_size])
  @@index([linkedin_employees])
  @@map("companies")
}

/// System settings untuk menyimpan konfigurasi dan data sistem
model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       Json?
  description String?  @db.VarChar(500)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([key])
  @@map("system_settings")
}

/// Enhanced Locations table dengan koordinat GPS
model JobLocation {
  id                Int      @id @default(autoincrement())
  city              String?  @db.VarChar(255)
  region            String?  @db.VarChar(255)
  country           String   @db.VarChar(255)
  timezone          String?  @db.VarChar(100)
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  raw_location_data Json?
  location_type     String?  @db.VarChar(100)
  is_remote         Boolean  @default(false)
  created_at        DateTime @default(now())
  jobs              Job[]

  @@unique([city, region, country])
  @@index([country])
  @@index([is_remote])
  @@index([latitude, longitude])
  @@map("job_locations")
}

/// Enhanced Jobs table dengan FULL LinkedIn API integration
model Job {
  id                        Int              @id @default(autoincrement())
  title                     String           @db.VarChar(255)
  slug                      String           @db.VarChar(255)
  company_id                Int
  location_id               Int?
  description               String
  employment_type           String           @db.VarChar(50)
  seniority_level           String?          @db.VarChar(100)
  status                    String           @default("active") @db.VarChar(50)
  direct_apply              Boolean          @default(true)
  external_url              String?          @db.VarChar(500)
  posted_date               DateTime
  valid_until               DateTime?
  source_type               String?          @db.VarChar(100)
  source                    String?          @db.VarChar(100)
  source_domain             String?          @db.VarChar(255)
  source_url                String?          @db.VarChar(500)
  linkedin_job_id           String?          @db.VarChar(255)
  recruiter_name            String?          @db.VarChar(255)
  recruiter_title           String?          @db.VarChar(255)
  recruiter_url             String?          @db.VarChar(500)
  salary_raw                String?          @db.VarChar(500)
  location_requirements_raw String?
  meta_title                String?          @db.VarChar(255)
  meta_description          String?          @db.VarChar(500)
  api_created_at            DateTime?
  created_at                DateTime         @default(now())
  updated_at                DateTime         @updatedAt
  ai_insights               JobAIInsights?
  applications              JobApplication[]
  company                   Company          @relation(fields: [company_id], references: [id])
  location                  JobLocation?     @relation(fields: [location_id], references: [id])
  saved_by_users            UserSavedJob[]

  @@unique([company_id, slug])
  @@index([company_id])
  @@index([location_id])
  @@index([employment_type])
  @@index([seniority_level])
  @@index([posted_date(sort: Desc)])
  @@index([source])
  @@map("jobs")
}

/// AI-Enhanced Job Insights (GAME CHANGER!)
model JobAIInsights {
  id                         Int      @id @default(autoincrement())
  job_id                     Int      @unique
  ai_salary_currency         String?  @db.VarChar(3)
  ai_salary_value            Int?
  ai_salary_min_value        Int?
  ai_salary_max_value        Int?
  ai_salary_unit_text        String?  @db.VarChar(100)
  ai_benefits                String?
  ai_experience_level        String?  @db.VarChar(100)
  ai_work_arrangement        String?  @db.VarChar(100)
  ai_work_arrangement_days   Int?
  ai_remote_location         String?  @db.VarChar(255)
  ai_remote_location_derived String?  @db.VarChar(255)
  ai_key_skills              Json?
  ai_core_responsibilities   String?
  ai_requirements_summary    String?
  ai_working_hours           String?  @db.VarChar(100)
  ai_job_language            String?  @db.VarChar(100)
  ai_visa_sponsorship        Boolean?
  ai_hiring_manager_name     String?  @db.VarChar(255)
  ai_hiring_manager_email    String?  @db.VarChar(255)
  salary_confidence          Decimal? @db.Decimal(3, 2)
  skills_confidence          Decimal? @db.Decimal(3, 2)
  requirements_confidence    Decimal? @db.Decimal(3, 2)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt
  job                        Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@index([ai_experience_level])
  @@index([ai_work_arrangement])
  @@index([ai_salary_min_value, ai_salary_max_value])
  @@map("job_ai_insights")
}

/// User Job Applications dengan enhanced tracking
model JobApplication {
  id           Int      @id @default(autoincrement())
  job_id       Int
  user_id      Int
  status       String   @default("PENDING") @db.VarChar(50)
  cover_letter String?
  resume_url   String?  @db.VarChar(500)
  applied_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  notes        String?
  job          Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, job_id])
  @@index([user_id])
  @@index([job_id])
  @@index([status])
  @@map("job_applications")
}

/// User Saved Jobs untuk favorites
model UserSavedJob {
  user_id  Int
  job_id   Int
  saved_at DateTime @default(now())
  id       Int      @id @default(autoincrement())
  job      Job      @relation(fields: [job_id], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, job_id])
  @@index([user_id])
  @@index([job_id])
  @@map("user_saved_jobs")
}

model Testimonial {
  id         Int               @id @default(autoincrement())
  name       String            @db.VarChar(255)
  country    String            @db.VarChar(100)
  text       String
  rating     Int               @default(5)
  status     TestimonialStatus @default(ACTIVE)
  featured   Boolean           @default(false)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt

  @@index([status])
  @@index([featured])
  @@index([country])
  @@map("testimonials")
}

model Program {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  image       String        @db.VarChar(500)
  description String
  status      ProgramStatus @default(ACTIVE)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  @@index([status])
  @@index([slug])
  @@map("programs")
}

/// Main RYLS registration form data
model RylsRegistration {
  id                      Int                        @id @default(autoincrement())
  full_name               String                     @db.VarChar(255)
  email                   String                     @db.VarChar(255)
  residence               String                     @db.VarChar(255)
  nationality             String                     @db.VarChar(255)
  second_nationality      String?                    @db.VarChar(255)
  whatsapp                String                     @db.VarChar(50)
  institution             String                     @db.VarChar(255)
  date_of_birth           DateTime                   @db.Date
  gender                  RylsGender
  discover_source         RylsDiscoverSource
  discover_other_text     String?
  scholarship_type        RylsScholarshipType
  created_at              DateTime                   @default(now())
  updated_at              DateTime                   @updatedAt
  ryls_payment_id         Int?
  fully_funded_submission RylsFullyFundedSubmission? @relation("RegistrationToFullyFunded")
  payments                RylsPayment[]
  self_funded_submission  RylsSelfFundedSubmission?  @relation("RegistrationToSelfFunded")

  @@index([scholarship_type])
  @@index([created_at(sort: Desc)])
  @@index([ryls_payment_id])
  @@map("ryls_registrations")
}

/// Draft registration for partial form submission
model RylsDraftRegistration {
  id               Int      @id @default(autoincrement())
  email            String   @db.VarChar(255)
  resume_token     String   @unique @db.VarChar(64)
  current_step     Int      @default(1)
  form_data        Json
  scholarship_type String?  @db.VarChar(50)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([email])
  @@map("ryls_draft_registrations")
}

/// File upload metadata
model FileUpload {
  id                    Int                        @id @default(autoincrement())
  original_name         String                     @db.VarChar(255)
  file_path             String                     @db.VarChar(500)
  file_size             Int
  mime_type             String                     @db.VarChar(100)
  created_at            DateTime                   @default(now())
  upload_type           String                     @db.VarChar(50)
  cohort_module_id      Int?
  academy_id            Int?
  fully_funded_essays   RylsFullyFundedSubmission? @relation("FullyFundedToFile")
  payment_proofs        RylsPayment?               @relation("PaymentToFileUpload")
  self_funded_headshots RylsSelfFundedSubmission?  @relation("SelfFundedToFile")
  cohort_module         CohortModule?              @relation("CohortModuleFiles", fields: [cohort_module_id], references: [id], onDelete: SetNull)
  academy               Academy?                   @relation("AcademyFiles", fields: [academy_id], references: [id], onDelete: SetNull)

  @@index([upload_type])
  @@index([created_at(sort: Desc)])
  @@index([cohort_module_id])
  @@index([academy_id])
  @@map("file_uploads")
}

/// Fully funded scholarship submissions
model RylsFullyFundedSubmission {
  id                Int              @id @default(autoincrement())
  registration_id   Int              @unique
  essay_topic       String?
  essay_file_id     Int?             @unique
  essay_description String?
  created_at        DateTime         @default(now())
  essay_file        FileUpload?      @relation("FullyFundedToFile", fields: [essay_file_id], references: [id])
  registration      RylsRegistration @relation("RegistrationToFullyFunded", fields: [registration_id], references: [id], onDelete: Cascade)

  @@index([registration_id])
  @@index([essay_file_id])
  @@map("ryls_fully_funded_submissions")
}

/// Self funded submissions
model RylsSelfFundedSubmission {
  id               Int              @id @default(autoincrement())
  registration_id  Int              @unique
  passport_number  String           @db.VarChar(100)
  need_visa        Boolean
  headshot_file_id Int?             @unique
  read_policies    Boolean
  created_at       DateTime         @default(now())
  headshot_file    FileUpload?      @relation("SelfFundedToFile", fields: [headshot_file_id], references: [id])
  registration     RylsRegistration @relation("RegistrationToSelfFunded", fields: [registration_id], references: [id], onDelete: Cascade)

  @@index([registration_id])
  @@index([headshot_file_id])
  @@map("ryls_self_funded_submissions")
}

/// RYLS payment information (Phase 2: Clean - only new columns)
model RylsPayment {
  id               Int               @id @default(autoincrement())
  registration_id  Int?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  payment_proof_id Int?              @unique
  status           String            @default("pending") @db.VarChar(50)
  transaction_id   Int?              @unique
  scholarship_type String            @db.VarChar(50)
  payment_method   String            @db.VarChar(50)
  payment_proof    FileUpload?       @relation("PaymentToFileUpload", fields: [payment_proof_id], references: [id])
  registration     RylsRegistration? @relation(fields: [registration_id], references: [id])
  transaction      Transaction?      @relation("TransactionToRylsPayment", fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([registration_id])
  @@index([status])
  @@map("ryls_payments")
}

/// Layer 1: Generic Transaction (Provider-Agnostic)
model Transaction {
  id                    Int                  @id @default(autoincrement())
  transaction_code      String               @unique @db.VarChar(100)
  provider_reference    String?              @db.VarChar(100)
  amount                Int
  currency              String               @default("IDR") @db.VarChar(10)
  status                String               @default("pending") @db.VarChar(50)
  provider              String               @db.VarChar(50)
  payment_method        String?              @db.VarChar(50)
  payment_token         String?              @db.VarChar(500)
  payment_url           String?              @db.VarChar(500)
  customer_name         String               @db.VarChar(255)
  customer_email        String               @db.VarChar(255)
  customer_phone        String?              @db.VarChar(50)
  customer_address      String?              @db.VarChar(500)
  customer_city         String?              @db.VarChar(100)
  customer_postal_code  String?              @db.VarChar(20)
  customer_country_code String?              @db.VarChar(10)
  user_id               Int?
  product_type          String               @db.VarChar(100)
  product_type_id       Int
  metadata              Json?
  paid_at               DateTime?
  expired_at            DateTime?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  midtrans_data         MidtransTransaction?
  ryls_payment          RylsPayment?         @relation("TransactionToRylsPayment")
  academy_enrollment    AcademyEnrollment?   @relation("TransactionToAcademyEnrollment")
  items                 TransactionItem[]
  user                  User?                @relation("UserTransactions", fields: [user_id], references: [id])

  @@index([transaction_code])
  @@index([status])
  @@index([provider])
  @@index([product_type, product_type_id])
  @@index([user_id])
  @@index([payment_method])
  @@index([created_at(sort: Desc)])
  @@map("transactions")
}

/// Transaction line items
model TransactionItem {
  id               Int         @id @default(autoincrement())
  transaction_id   Int
  product_code     String      @db.VarChar(100)
  product_name     String      @db.VarChar(255)
  product_category String?     @db.VarChar(100)
  quantity         Int         @default(1)
  unit_price       Int
  total_price      Int
  metadata         Json?
  created_at       DateTime    @default(now())
  transaction      Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([transaction_id])
  @@map("transaction_items")
}

/// Layer 2: Provider-Specific Data (Midtrans)
model MidtransTransaction {
  id                      Int         @id @default(autoincrement())
  transaction_id          Int         @unique
  snap_token              String      @db.VarChar(500)
  redirect_url            String?     @db.VarChar(500)
  midtrans_order_id       String      @db.VarChar(100)
  midtrans_transaction_id String?     @db.VarChar(100)
  transaction_status      String?     @db.VarChar(50)
  fraud_status            String?     @db.VarChar(50)
  payment_type            String?     @db.VarChar(50)
  bank                    String?     @db.VarChar(50)
  va_numbers              Json?
  masked_card             String?     @db.VarChar(50)
  status_code             String?     @db.VarChar(10)
  status_message          String?     @db.VarChar(255)
  approval_code           String?     @db.VarChar(50)
  create_response         Json?
  last_notification       Json?
  status_response         Json?
  settlement_time         DateTime?
  notified_at             DateTime?
  created_at              DateTime    @default(now())
  updated_at              DateTime    @updatedAt
  transaction             Transaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  @@index([midtrans_order_id])
  @@index([transaction_status])
  @@index([midtrans_transaction_id])
  @@map("midtrans_transactions")
}

/// Cohort - batch/class instance of an Academy
model Cohort {
  id           Int                       @id @default(autoincrement())
  academy_id   Int
  name         String                    @db.VarChar(100)
  description  String?                   @db.VarChar(255)
  status       String                    @default("not_started") @db.VarChar(20)
  start_date   DateTime?                 @db.Date
  end_date     DateTime?                 @db.Date
  created_at   DateTime                  @default(now())
  updated_at   DateTime                  @updatedAt
  academy      Academy                   @relation("AcademyCohorts", fields: [academy_id], references: [id], onDelete: Cascade)
  modules      CohortModule[]           @relation("CohortModules")
  attachments  CohortModuleAttachment[] @relation("CohortAttachments")
  placements   CohortPlacement[]        @relation("CohortPlacements")
  mentors      CohortMentor[]           @relation("CohortMentors")
  certificates CohortCertificate[]      @relation("CohortCertificates")

  @@index([academy_id])
  @@index([status])
  @@map("cohorts")
}

/// CohortModule - scheduled session within a cohort
model CohortModule {
  id                Int                       @id @default(autoincrement())
  academy_id        Int
  cohort_id         Int
  title             String                    @db.VarChar(200)
  description       String?
  is_published      Boolean                   @default(false)
  session_start_time DateTime?
  session_end_time   DateTime?
  meeting_link       String?                   @db.VarChar(500)
  attendance_link     String?                      @db.VarChar(500)
  assignment_title    String?                      @db.VarChar(255)
  assignment_link     String?                      @db.VarChar(500)
  assignment_deadline DateTime?
  order               Int                          @default(1)
  created_at          DateTime                     @default(now())
  updated_at          DateTime                     @updatedAt
  academy             Academy                      @relation("AcademyCohortModules", fields: [academy_id], references: [id], onDelete: Cascade)
  cohort              Cohort                       @relation("CohortModules", fields: [cohort_id], references: [id], onDelete: Cascade)
  attachments         CohortModuleAttachment[]     @relation("ModuleAttachments")
  file_uploads        FileUpload[]                 @relation("CohortModuleFiles")
  assignment_completions CohortAssignmentCompletion[] @relation("ModuleAssignmentCompletions")

  @@unique([cohort_id, order])
  @@index([academy_id])
  @@index([session_start_time])
  @@map("cohort_modules")
}

/// CohortModuleAttachment - files/links attached to a module
model CohortModuleAttachment {
  id               Int          @id @default(autoincrement())
  academy_id       Int
  cohort_id        Int
  cohort_module_id Int
  type             String       @db.VarChar(20)
  label            String?      @db.VarChar(150)
  file_path        String?      @db.VarChar(500)
  file_mime        String?      @db.VarChar(100)
  file_size_kb     Int?
  url              String?      @db.VarChar(1000)
  embed_provider   String?      @db.VarChar(50)
  order            Int          @default(1)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  academy          Academy      @relation("AcademyCohortAttachments", fields: [academy_id], references: [id], onDelete: Cascade)
  cohort           Cohort       @relation("CohortAttachments", fields: [cohort_id], references: [id], onDelete: Cascade)
  module           CohortModule @relation("ModuleAttachments", fields: [cohort_module_id], references: [id], onDelete: Cascade)

  @@index([cohort_module_id, order])
  @@index([cohort_id])
  @@map("cohort_module_attachments")
}


/// CohortMentor - standalone mentor for a cohort (no user account required)
model CohortMentor {
  id         Int      @id @default(autoincrement())
  academy_id Int
  cohort_id  Int
  name       String   @db.VarChar(150)
  avatar     String?  @db.VarChar(500)
  job_title  String?  @db.VarChar(150)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  academy    Academy  @relation("AcademyCohortMentors", fields: [academy_id], references: [id])
  cohort     Cohort   @relation("CohortMentors", fields: [cohort_id], references: [id], onDelete: Cascade)

  @@index([cohort_id])
  @@index([academy_id])
  @@map("cohort_mentors")
}

/// CohortCertificate - certificate issued to a student upon completion
model CohortCertificate {
  id               Int             @id @default(autoincrement())
  academy_id       Int
  cohort_id        Int
  placement_id     Int             @unique
  user_id          Int
  certificate_code String          @unique @db.VarChar(100)
  student_name     String          @db.VarChar(255)
  academy_title    String          @db.VarChar(255)
  cohort_name      String          @db.VarChar(100)
  grades_transcript Json?
  file_path        String?         @db.VarChar(500)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  academy          Academy         @relation("AcademyCohortCertificates", fields: [academy_id], references: [id])
  cohort           Cohort          @relation("CohortCertificates", fields: [cohort_id], references: [id], onDelete: Cascade)
  placement        CohortPlacement @relation("PlacementCertificate", fields: [placement_id], references: [id], onDelete: Cascade)
  user             User            @relation("UserCohortCertificates", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([cohort_id, user_id])
  @@index([user_id])
  @@map("cohort_certificates")
}

/// CohortAssignmentCompletion - tracks whether a student has marked a module's assignment as done
model CohortAssignmentCompletion {
  id               Int          @id @default(autoincrement())
  cohort_module_id Int
  user_id          Int
  completed_at     DateTime     @default(now())
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  cohort_module    CohortModule @relation("ModuleAssignmentCompletions", fields: [cohort_module_id], references: [id], onDelete: Cascade)
  user             User         @relation("UserAssignmentCompletions", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([cohort_module_id, user_id])
  @@index([user_id])
  @@index([cohort_module_id])
  @@map("cohort_assignment_completions")
}

/// Registry of all available admin permission resources
model AdminPermission {
  key              String   @id
  name             String
  description      String?
  available_levels String[]
  created_at       DateTime @default(now())

  user_permissions UserAdminPermission[]

  @@map("admin_permissions")
}

/// Assignment of a permission resource + level to an admin user
model UserAdminPermission {
  id             Int              @id @default(autoincrement())
  user_id        Int
  permission_key String
  access_level   AdminAccessLevel
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permission_key], references: [key], onDelete: Cascade)

  @@unique([user_id, permission_key])
  @@index([user_id])
  @@map("user_admin_permissions")
}

enum UserRole {
  ADMIN
  USER
  SUPERADMIN
}

enum AdminAccessLevel {
  VIEWER
  EDITOR
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum AcademyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TestimonialStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum RylsRegistrationStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum RylsGender {
  FEMALE
  MALE
  PREFER_NOT_TO_SAY
}

enum RylsDiscoverSource {
  RISE_INSTAGRAM
  OTHER_INSTAGRAM
  FRIENDS
  OTHER
}

enum RylsScholarshipType {
  FULLY_FUNDED
  SELF_FUNDED
}

/// AcademyEnrollment - Layer 3 Payment: represents purchasing an academy (parent of CohortPlacement)
model AcademyEnrollment {
  id             Int              @id @default(autoincrement())
  academy_id     Int
  user_id        Int
  transaction_id Int              @unique
  completed_at   DateTime?
  notes          String?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  academy        Academy          @relation("AcademyEnrollments", fields: [academy_id], references: [id], onDelete: Cascade)
  user           User             @relation("UserAcademyEnrollments", fields: [user_id], references: [id], onDelete: Cascade)
  transaction    Transaction      @relation("TransactionToAcademyEnrollment", fields: [transaction_id], references: [id])
  placement      CohortPlacement?

  @@index([user_id, academy_id])
  @@map("academy_enrollments")
}

/// CohortPlacement - admin-assigned placement of a student into a specific cohort (child of AcademyEnrollment)
model CohortPlacement {
  id                    Int               @id @default(autoincrement())
  academy_enrollment_id Int               @unique
  cohort_id             Int
  user_id               Int
  academy_id            Int
  notes                 String?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt
  academy_enrollment    AcademyEnrollment @relation(fields: [academy_enrollment_id], references: [id], onDelete: Cascade)
  cohort                Cohort            @relation("CohortPlacements", fields: [cohort_id], references: [id], onDelete: Cascade)
  user                  User              @relation("UserCohortPlacements", fields: [user_id], references: [id], onDelete: Cascade)
  academy               Academy           @relation("AcademyCohortPlacements", fields: [academy_id], references: [id], onDelete: Cascade)
  certificate           CohortCertificate? @relation("PlacementCertificate")

  @@unique([cohort_id, user_id])
  @@index([cohort_id])
  @@index([academy_id])
  @@map("cohort_placements")
}
