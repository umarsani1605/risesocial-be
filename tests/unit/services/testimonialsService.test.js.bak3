          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Country must be at least 2 characters long');
      });

      it('should validate country maximum length (100 chars)', () => {
        const data = {
          name: 'John Doe',
          country: 'A'.repeat(101),
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Country must be less than 100 characters');
      });

      it('should allow missing country on update', () => {
        const data = {
          name: 'John Doe',
          text: 'This is a great testimonial with sufficient length.',
        };

        const result = adminTestimonialsService.validateTestimonialData(data, true);

        expect(result.isValid).toBe(true);
        expect(result.errors).toHaveLength(0);
      });
    });

    describe('text validation', () => {
      it('should require text on create', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Text is required and must be a string');
      });

      it('should validate text is a string', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 123,
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Text is required and must be a string');
      });

      it('should validate text minimum length (10 chars)', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'Too short',
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Text must be at least 10 characters long');
      });

      it('should validate text maximum length (1000 chars)', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'A'.repeat(1001),
          rating: 5,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors.some((err) => err.includes('Text must be'))).toBe(true);
      });

      it('should allow missing text on update', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
        };

        const result = adminTestimonialsService.validateTestimonialData(data, true);

        expect(result.isValid).toBe(true);
        expect(result.errors).toHaveLength(0);
      });
    });

    describe('rating validation', () => {
      it('should validate rating is between 1 and 5', () => {
        const validRatings = [1, 2, 3, 4, 5];

        validRatings.forEach((rating) => {
          const data = {
            name: 'John Doe',
            country: 'Indonesia',
            text: 'This is a great testimonial with sufficient length.',
            rating,
          };

          const result = adminTestimonialsService.validateTestimonialData(data, false);

          expect(result.isValid).toBe(true);
          expect(result.errors).toHaveLength(0);
        });
      });

      it('should reject rating less than 1', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 0,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Rating must be a number between 1 and 5');
      });

      it('should reject rating greater than 5', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 6,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Rating must be a number between 1 and 5');
      });

      it('should reject non-numeric rating', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 'invalid',
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Rating must be a number between 1 and 5');
      });
    });

    describe('status validation', () => {
      it('should accept valid status values (ACTIVE, INACTIVE, PENDING)', () => {
        const validStatuses = ['ACTIVE', 'INACTIVE', 'PENDING'];

        validStatuses.forEach((status) => {
          const data = {
            name: 'John Doe',
            country: 'Indonesia',
            text: 'This is a great testimonial with sufficient length.',
            rating: 5,
            status,
          };

          const result = adminTestimonialsService.validateTestimonialData(data, false);

          expect(result.isValid).toBe(true);
          expect(result.errors).toHaveLength(0);
        });
      });

      it('should reject invalid status values', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
          status: 'INVALID_STATUS',
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Status must be one of: ACTIVE, INACTIVE, PENDING');
      });
    });

    describe('featured validation', () => {
      it('should validate featured is a boolean', () => {
        const validFeaturedValues = [true, false];

        validFeaturedValues.forEach((featured) => {
          const data = {
            name: 'John Doe',
            country: 'Indonesia',
            text: 'This is a great testimonial with sufficient length.',
            rating: 5,
            featured,
          };

          const result = adminTestimonialsService.validateTestimonialData(data, false);

          expect(result.isValid).toBe(true);
          expect(result.errors).toHaveLength(0);
        });
      });

      it('should reject non-boolean featured values', () => {
        const invalidFeaturedValues = ['yes', 'no', 1, 0, 'true', 'false'];

        invalidFeaturedValues.forEach((featured) => {
          const data = {
            name: 'John Doe',
            country: 'Indonesia',
            text: 'This is a great testimonial with sufficient length.',
            rating: 5,
            featured,
          };

          const result = adminTestimonialsService.validateTestimonialData(data, false);

          expect(result.isValid).toBe(false);
          expect(result.errors).toContain('Featured must be a boolean');
        });
      });
    });

    describe('avatar_url validation', () => {
      it('should allow null avatar_url', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
          avatar_url: null,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(true);
        expect(result.errors).toHaveLength(0);
      });

      it('should validate avatar_url maximum length (500 chars)', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
          avatar_url: 'https://example.com/' + 'A'.repeat(500),
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors.some((err) => err.includes('Avatar URL'))).toBe(true);
      });
    });

    describe('validation result', () => {
      it('should return isValid: true with no errors for valid data', () => {
        const data = {
          name: 'John Doe',
          country: 'Indonesia',
          text: 'This is a great testimonial with sufficient length.',
          rating: 5,
          status: 'ACTIVE',
          featured: true,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(true);
        expect(result.errors).toHaveLength(0);
      });

      it('should return isValid: false with errors array for invalid data', () => {
        const data = {
          name: 'A',
          country: 'B',
          text: 'Short',
          rating: 10,
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toBeInstanceOf(Array);
        expect(result.errors.length).toBeGreaterThan(0);
      });

      it('should return all validation errors in errors array', () => {
        const data = {
          name: 'A',
          country: 'B',
          text: 'Short',
          rating: 10,
          status: 'INVALID',
          featured: 'yes',
        };

        const result = adminTestimonialsService.validateTestimonialData(data, false);

        expect(result.isValid).toBe(false);
        expect(result.errors).toBeInstanceOf(Array);
        expect(result.errors.length).toBeGreaterThan(3);
        expect(result.errors.some((err) => err.includes('Name'))).toBe(true);
        expect(result.errors.some((err) => err.includes('Country'))).toBe(true);
        expect(result.errors.some((err) => err.includes('Text'))).toBe(true);
        expect(result.errors.some((err) => err.includes('Rating'))).toBe(true);
        expect(result.errors.some((err) => err.includes('Status'))).toBe(true);
        expect(result.errors.some((err) => err.includes('Featured'))).toBe(true);
      });
    });
  });
});
